# Copy to ignored terraform.tfvars; supply secrets only through environment.
project_id           = "proxysql-demo-unique"
task_id              = "mysql-proxysql-demo"
location             = "japaneast"
resource_group_name  = "rg-dev2"
node_vm_size         = "Standard_B2ls_v2"
redis_vm_size        = "Standard_B2ats_v2"
mysql_sku            = "B_Standard_B1ms"
mysql_ha_enabled     = false
observability_enabled = false
public_http_enabled  = false
allowed_http_cidrs   = []
# Public HTTP requires opt-in AND your actual restricted /32 (not this example).
# public_http_enabled = true
# allowed_http_cidrs = ["203.0.113.10/32"]
# For HA choose a General Purpose MySQL SKU; Burstable does not support HA.
# ssh_public_key is generated by the operation scripts if not supplied.

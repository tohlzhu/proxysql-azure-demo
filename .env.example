# Copy only for customization; make demo-local generates fresh local passwords.
COMPOSE_PROJECT_NAME=proxysql-demo
MYSQL_DATABASE=ratelimitdemo
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=replace-with-generated-local-password
MYSQL_APP_USER=demo
MYSQL_APP_PASSWORD=replace-with-generated-local-password
MYSQL_MONITOR_USER=monitor
MYSQL_MONITOR_PASSWORD=replace-with-generated-local-password
PROXYSQL_ADMIN_PASSWORD=replace-with-generated-local-password
REDIS_PASSWORD=replace-with-generated-local-password
LIMITER_MODE=distributed
HTTP_PORT=8080
REDIS_PORT=16379
